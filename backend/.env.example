PORT=5000
MONGODB_URI=mongodb://localhost:27017/freshmart
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:8080

# Nodemailer Email Credentials (leave empty to use Ethereal mock email server)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FreshMart <noreply@freshmart.com>

# Razorpay Credentials (leave empty to enable frontend Mock payment flow)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
